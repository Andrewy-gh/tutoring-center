{
  "name": "tutoring-center",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "check:node-version": "node scripts/check-node-version.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-drizzle.ts",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:start": "docker compose up -d --wait db",
    "db:status": "docker compose ps",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs db",
    "local:db:bootstrap": "npm run db:start && npm run db:migrate && npm run db:seed:local",
    "gate:local": "npm run check:node-version && npm run local:db:bootstrap && npm run typecheck && npm run lint && npm run test && npm run prettier:check && npm run build",
    "knip": "npm exec --yes --package=knip@6.0.3 -- knip",
    "knip:deps": "npm exec --yes --package=knip@6.0.3 -- knip --include dependencies --include unlisted --no-progress",
    "lint": "eslint . --max-warnings=0",
    "preinstall": "node scripts/check-node-version.ts",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "prepare": "node -e \"if (process.env.CI) process.exit(0); try { const huskyBin = require.resolve('husky/bin.js'); require('child_process').execFileSync(process.execPath, [huskyBin], { stdio: 'inherit' }); } catch { process.exit(0); }\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.564.0",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "knip": "^6.0.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "24.x"
  }
}
